# ---------------------------------------------------------------------------
# SYNAX AI — backend environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# OpenRouter (server-side only — never exposed to the browser)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=SYNAX AI

# Models used by the agent council
SYNAX_PLANNER_MODEL=anthropic/claude-3.5-sonnet
SYNAX_RESEARCHER_MODEL=perplexity/llama-3.1-sonar-large-128k-online
SYNAX_ANALYST_MODEL=anthropic/claude-3.5-sonnet
SYNAX_WRITER_MODEL=anthropic/claude-3.5-sonnet
SYNAX_CRITIC_MODEL=openai/gpt-4o-mini
SYNAX_DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=synax

# Server
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Uploads
MAX_UPLOAD_MB=20
UPLOAD_DIR=./uploads

# Optional: shared secret for simple bearer auth (leave blank to disable)
SYNAX_API_TOKEN=
